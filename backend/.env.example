# Copy to backend/.env and fill in. Everything is optional - without a key CivicPulse runs fully offline.

# Claude API key -> enables AI extraction (multilingual understanding + photo severity)
ANTHROPIC_API_KEY=

# auto | claude | ollama | rules
#   auto   = Claude when a key is present, otherwise offline rules
#   ollama = FREE local models via Ollama (no key, nothing leaves your machine)
CIVICPULSE_EXTRACTOR=auto
CIVICPULSE_LLM_MODEL=claude-haiku-4-5

# Who checks after-repair photos: auto | claude | ollama | none
#   auto = Claude if a key is set, else local Ollama if running, else supervisor review
CIVICPULSE_VERIFIER=auto

# Local models (used when CIVICPULSE_EXTRACTOR=ollama or the verifier is ollama). Install with: ollama pull <model>
CIVICPULSE_OLLAMA_URL=http://localhost:11434
CIVICPULSE_OLLAMA_TEXT_MODEL=qwen2.5:7b
CIVICPULSE_OLLAMA_VISION_MODEL=gemma3:4b

# 1 = geocode landmarks with OpenStreetMap Nominatim (rate limited to ~1 req/s; good for live demos)
CIVICPULSE_NOMINATIM=0

# Dedup tuning
DEDUP_RADIUS_M=300
DEDUP_WINDOW_DAYS=14
DEDUP_MERGE_THRESHOLD=0.72
DEDUP_REVIEW_THRESHOLD=0.60

# Officials' portal: the first supervisor account is created from these on startup.
CIVICPULSE_ADMIN_USER=admin
CIVICPULSE_ADMIN_PASSWORD=
# Signs login sessions; use a long random value (e.g. python -c "import secrets; print(secrets.token_hex(32))")
CIVICPULSE_SECRET_KEY=

# Deployment
# CIVICPULSE_ENV=production         # strict mode: requires a 32+ char secret key, Secure cookies, HSTS, hides /docs
# CIVICPULSE_MAX_BODY_MB=14         # largest request accepted (photos / voice notes)
# CIVICPULSE_TRUST_PROXY=1          # behind Render/nginx so rate limits see the real client IP
# CIVICPULSE_DEMO_DATA=1            # show the "simulated data" banner on the citizen portal
# CIVICPULSE_SEED_DEMO=1            # bootstrap loads demo complaints into an empty database
# CIVICPULSE_DB=/data/civicpulse.db
# CIVICPULSE_UPLOAD_DIR=/data/uploads

# Voice notes (web "Record voice note" + WhatsApp voice notes)
# auto = local faster-whisper if installed (pip install -r requirements-voice.txt), else the API below if a key is set
# CIVICPULSE_TRANSCRIBER=auto       # auto | local | api | none
# CIVICPULSE_WHISPER_MODEL=small    # local model: small (good Hindi, ~1 GB RAM) or base (faster, weaker Hindi)
# CIVICPULSE_WHISPER_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
# CIVICPULSE_WHISPER_API_KEY=       # free Groq key works; any OpenAI-compatible Whisper endpoint
# CIVICPULSE_WHISPER_API_MODEL=whisper-large-v3

# WhatsApp intake (Twilio). Webhook: POST https://<your-app>/api/whatsapp/webhook
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=                # also verifies that webhook calls really come from Twilio
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # sandbox number, or your approved WhatsApp sender
# CIVICPULSE_PUBLIC_URL=https://galligraph.onrender.com
# CIVICPULSE_WHATSAPP_ALLOW_UNSIGNED=1   # local testing only: accept webhook calls without a Twilio signature

# Privacy / data retention (see "Security & privacy" in README)
# CIVICPULSE_CONTACT_RETENTION_DAYS=30   # erase citizens' phone numbers this long after their issue is closed
# CIVICPULSE_PHOTO_RETENTION_DAYS=0      # delete evidence photos this long after closure (0 = keep)
